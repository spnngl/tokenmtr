{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The main window: every data source command; native work (dialogs, Finder, notifications) goes through them, so no plugin permission is granted to the webview.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-app-state",
    "allow-filter-options",
    "allow-settings",
    "allow-session-origin",
    "allow-overview",
    "allow-series",
    "allow-models",
    "allow-projects",
    "allow-project-models",
    "allow-project-remotes",
    "allow-branches",
    "allow-unresolved-cwds",
    "allow-heatmap",
    "allow-tools",
    "allow-signals",
    "allow-billing",
    "allow-billing-series",
    "allow-quota-latest",
    "allow-quota-history",
    "allow-advisor",
    "allow-sessions",
    "allow-session-detail",
    "allow-session-analytics",
    "allow-session-timeline",
    "allow-budgets",
    "allow-recap",
    "allow-system-health",
    "allow-ingest-status",
    "allow-parse-issues",
    "allow-alerts",
    "allow-backups",
    "allow-fx-rates",
    "allow-scan-now",
    "allow-export-now",
    "allow-backup-now",
    "allow-open-dashboard",
    "allow-install-daemon",
    "allow-restart-daemon",
    "allow-reveal-path",
    "allow-add-project-rule",
    "allow-add-subscription",
    "allow-set-menubar-rings",
    "allow-set-git-defaults",
    "allow-project-rule-for",
    "allow-connect-keychain",
    "allow-keep-ten-years",
    "allow-set-launch-at-login",
    "allow-erase-all-data",
    "allow-complete-onboarding",
    "allow-request-notifications",
    "allow-generate-report",
    "allow-save-report"
  ]
}
